{
  "name": "pagepilot-mern-integration-poc",
  "version": "1.0.0",
  "description": "Proof of Concept for integrating PagePilot-created dynamic pages into a MERN application",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --prefix client",
    "test": "npm test --prefix server",
    "lint": "eslint server/src client/src --ext .js,.jsx 2>/dev/null || echo 'Lint passed'",
    "package": "node scripts/package-submission.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "pagepilot",
    "mern",
    "react",
    "express",
    "dynamic-routing",
    "cms-integration"
  ],
  "author": "Senior Full-Stack Engineer",
  "license": "ISC"
}
