# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PagePilot Workspace Configuration
# Base API URL of the PagePilot instance (default: https://pagepilot.fabbuilder.com/api)
PAGEPILOT_BASE_URL=https://pagepilot.fabbuilder.com/api

# The 24-character hex ID of your PagePilot workspace/tenant
PAGEPILOT_WORKSPACE_ID=YOUR_WORKSPACE_ID_HERE

# Optional Service Token / API Key (if authenticated preview or write endpoints are used)
PAGEPILOT_API_KEY=

# Cache duration in seconds for published pages (e.g. 60)
PAGE_CACHE_TTL_SECONDS=60
